# Copy to .env.prod on the server (cp .env.prod.example .env.prod) and fill in every value. NEVER commit .env.prod.
DOMAIN=hcis.contoh-perusahaan.co.id

DB_USER=hcis
DB_NAME=dea_hcis
# openssl rand -hex 24
DB_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK

# openssl rand -hex 32   (min. 32 karakter; mengganti nilai ini = semua user harus login ulang, dan akun Google Drive harus dihubungkan ulang)
JWT_SECRET=GANTI_DENGAN_HEX_64_KARAKTER

# Dipakai HANYA saat database pertama kali terisi (seed). Kosongkan SEED_ADMIN_PASSWORD = dibuat acak & dicetak di log sekali.
SEED_ADMIN_PASSWORD=
# Password awal semua akun karyawan. Kosong = acak (HR harus mengatur password tiap karyawan di Settings).
SEED_EMPLOYEE_PASSWORD=

# Google Drive (opsional, lihat docs/DEPLOY.md bagian Google Drive)
GDRIVE_ENABLED=false
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_ROOT_FOLDER_ID=
