DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dea_hcis
JWT_SECRET=change-me
PORT=8080
FRONTEND_ORIGIN=
UPLOAD_DIR=./uploads
# Phase 8 — Google Drive sync. Files are saved locally first, then a background job copies them to Drive as
#   CORE HCIS / <Bisnis> / <Tab: Karyawan | Cuti & Izin | Tugas | Proyek> / <Tahun> / <Nama file>
# Setup: Google Cloud Console → APIs & Services → enable "Google Drive API" → OAuth consent screen →
# Credentials → "OAuth client ID" (type: Web application) → add GDRIVE_REDIRECT_URL below as an Authorized redirect URI.
# Then paste the client id/secret here, restart, and click "Hubungkan Google Drive" in Settings → Google Drive.
GDRIVE_ENABLED=false
GDRIVE_CLIENT_ID=PASTE_OAUTH_CLIENT_ID_HERE
GDRIVE_CLIENT_SECRET=PASTE_OAUTH_CLIENT_SECRET_HERE
GDRIVE_REDIRECT_URL=http://localhost:8080/api/drive/callback
# optional: a refresh token obtained elsewhere (skips the in-app "Hubungkan" step)
GDRIVE_REFRESH_TOKEN=
# optional: use an existing Drive folder as the root instead of creating "CORE HCIS" (then the full "drive" scope is requested)
GDRIVE_ROOT_FOLDER_ID=
# LOCAL DEVELOPMENT ONLY — shows a "pick an account" list on the login and /absen pages and signs in without a
# password. It is an authentication bypass by design: keep it false (or unset) everywhere else, especially production.
DEV_LOGIN=false
