# Salin ke /etc/hcis/backend.env  (sudo cp, lalu sudo chmod 640 dan chown root:hcis). JANGAN di-commit.
APP_ENV=production
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=hcis
DB_NAME=dea_hcis
# sama dengan password saat CREATE USER di PostgreSQL (hasil: openssl rand -hex 24)
DB_PASSWORD=GANTI_PASSWORD_DB

# openssl rand -hex 32  (min. 32 karakter; server menolak start jika lemah)
JWT_SECRET=GANTI_HEX_64_KARAKTER

# tempat file unggahan (harus bisa ditulis user "hcis")
UPLOAD_DIR=/var/lib/hcis/uploads

# alamat yang dipakai browser mengakses aplikasi (tanpa slash di akhir):
#   sementara lewat IP:   http://IP_VPS
#   setelah ada HTTPS:    https://203-0-113-10.sslip.io  (atau domain Anda)
FRONTEND_ORIGIN=http://IP_VPS

# Nginx berjalan di server yang sama → hanya localhost yang dipercaya untuk X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# Password awal saat database PERTAMA KALI diisi. Kosong = acak (admin dicetak sekali di log: journalctl -u hcis-backend)
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Google Drive (opsional; butuh HTTPS, lihat docs/DEPLOY-VPS.md bagian 11)
GDRIVE_ENABLED=false
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URL=
GDRIVE_ROOT_FOLDER_ID=
